#include <bits/stdc++.h>
using namespace std;

int main(){
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, m, k;
    cin >> n >> m >> k;

    vector<vector<int>> adj(n + 1);
    for (int i = 0; i < m; i++) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    // best[node] = max remaining power that can reach this node from any tower
    // -1 means "not reached / not covered"
    vector<long long> best(n + 1, -1);

    // max-heap: (remaining_power, node)
    priority_queue<pair<long long,int>> pq;

    for (int i = 0; i < k; i++) {
        long long t, P;
        cin >> t >> P;
        if (P > best[t]) {
            best[t] = P;
            pq.push({P, (int)t});
        }
    }

    while (!pq.empty()) {
        auto [d, u] = pq.top();
        pq.pop();

        if (d != best[u]) continue; // stale entry, better value already found

        long long nd = d - 1;
        if (nd < 0) continue; // signal died out

        for (int v : adj[u]) {
            if (nd > best[v]) {
                best[v] = nd;
                pq.push({nd, v});
            }
        }
    }

    long long count = 0;
    for (int i = 1; i <= n; i++) {
        if (best[i] >= 0) count++;
    }

    cout << count << "\n";
    return 0;
}
