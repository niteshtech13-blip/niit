#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<long long> st;
    st.reserve(n);

    for (int i = 0; i < n; i++) {
        string op;
        cin >> op;
        if (op == "ADD") {
            long long x;
            cin >> x;
            st.push_back(x);
        } else { // REMOVE
            if (!st.empty()) st.pop_back();
        }
    }

    if (st.empty()) cout << -1 << endl;
    else cout << st.back() << endl;

    return 0;
}
