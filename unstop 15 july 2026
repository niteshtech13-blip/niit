#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<int> a(n);
    for (int i = 0; i < n; i++) cin >> a[i];

    // Longest Strictly Increasing Subsequence - O(N log N)
    vector<int> tails; // tails[i] = smallest possible tail value for LIS of length i+1

    for (int i = 0; i < n; i++) {
        // strictly increasing -> use lower_bound (replace first element >= a[i])
        auto it = lower_bound(tails.begin(), tails.end(), a[i]);
        if (it == tails.end())
            tails.push_back(a[i]);
        else
            *it = a[i];
    }

    cout << tails.size() << endl;
    return 0;
}
