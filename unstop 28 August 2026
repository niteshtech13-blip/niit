#include <iostream>
#include <vector>
#include <unordered_map>
#include <algorithm>

using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, k;
    if (!(cin >> n >> k)) return 0;

    vector<int> a(n);
    for (int i = 0; i < n; ++i) {
        cin >> a[i];
    }

    unordered_map<int, int> freq;
    int left = 0;
    int max_length = 0;

    for (int right = 0; right < n; ++right) {
        freq[a[right]]++;

        // Shrink the window from left if distinct elements exceed K
        while (freq.size() > static_cast<size_t>(k)) {
            freq[a[left]]--;
            if (freq[a[left]] == 0) {
                freq.erase(a[left]);
            }
            left++;
        }

        // Update maximum valid subarray length
        max_length = max(max_length, right - left + 1);
    }

    cout << max_length << "\n";

    return 0;
}
                
