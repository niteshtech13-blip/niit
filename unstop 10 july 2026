#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n;
    cin >> n;
    
    long long result = 0;
    for (int i = 0; i < n; i++) {
        long long x;
        cin >> x;
        result ^= x;
    }
    
    cout << result << endl;
    return 0;
}
