#include <iostream>
#include <vector>
using namespace std;

long long countDivisibleSegments(const vector<int>& arr, int n, int k) {
    vector<long long> freq(k, 0);

    long long count = 0;
    long long prefixSum = 0;

    // Empty prefix has remainder 0
    freq[0] = 1;

    for (int i = 0; i < n; i++) {
        prefixSum += arr[i];

        int rem = ((prefixSum % k) + k) % k; // Handle negative sums

        count += freq[rem];
        freq[rem]++;
    }

    return count;
}

int main() {
    int n, k;
    cin >> n >> k;

    vector<int> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    cout << countDivisibleSegments(arr, n, k) << endl;

    return 0;
}
                
