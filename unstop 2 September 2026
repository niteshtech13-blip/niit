#include <iostream>
#include <vector>
#include <stack>

using namespace std;

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<int> h(n);
    for (int i = 0; i < n; ++i) {
        cin >> h[i];
    }

    vector<int> ans(n);
    stack<int> st; // Stores indices of towers

    // Traverse from right to left
    for (int i = n - 1; i >= 0; --i) {
        // Pop elements smaller than or equal to current height
        while (!st.empty() && h[st.top()] <= h[i]) {
            st.pop();
        }

        if (st.empty()) {
            // No strictly taller tower to the right
            ans[i] = (n - 1) - i;
        } else {
            // Distance to the first strictly taller tower
            ans[i] = st.top() - i;
        }

        st.push(i);
    }

    for (int i = 0; i < n; ++i) {
        cout << ans[i] << (i == n - 1 ? "" : " ");
    }
    cout << "\n";

    return 0;
}
                
