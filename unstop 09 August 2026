#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
#include <unordered_map>
using namespace std;

int main() {
    int n;
    long long k;
    cin >> n >> k;

    vector<long long> a(n);
    for (int i = 0; i < n; i++) cin >> a[i];

    unordered_map<long long, long long> freq;
    freq.reserve(n * 2);
    freq[0] = 1; // prefixXOR[0] = 0 before we start

    long long prefixXOR = 0;
    long long ans = 0;

    for (int i = 0; i < n; i++) {
        prefixXOR ^= a[i];
        long long need = prefixXOR ^ k;

        auto it = freq.find(need);
        if (it != freq.end()) {
            ans += it->second;
        }

        freq[prefixXOR]++;
    }

    cout << ans << endl;
    return 0;
}
