#include <iostream>
#include <vector>
#include <string>
#include <queue>
#include <climits>

using namespace std;

long long calculateDecodeTime(const string& s) {
    long long total = 0;
    for (char c : s) {
        if (c >= 'a' && c <= 'z') {
            total += (c - 'a' + 1);
        }
    }
    return total;
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int N, M;
    cin >> N >> M;
    cin.ignore();
    
    vector<long long> decodeCost(N + 1);
    for (int i = 1; i <= N; i++) {
        string s;
        getline(cin, s);
        decodeCost[i] = calculateDecodeTime(s);
    }
    
    vector<vector<pair<int, long long>>> adj(N + 1);
    for (int i = 0; i < M; i++) {
        int u, v;
        long long T;
        cin >> u >> v >> T;
        adj[u].emplace_back(v, T);
        adj[v].emplace_back(u, T);
    }
    
    int start, end;
    cin >> start >> end;
    
    // Dijkstra's algorithm
    vector<long long> dist(N + 1, LLONG_MAX);
    priority_queue<pair<long long, int>, vector<pair<long long, int>>, greater<pair<long long, int>>> pq;
    
    dist[start] = decodeCost[start];
    pq.push({dist[start], start});
    
    while (!pq.empty()) {
        auto [d, u] = pq.top();
        pq.pop();
        
        if (d > dist[u]) continue;
        
        for (auto [v, edgeTime] : adj[u]) {
            long long newDist = dist[u] + edgeTime + decodeCost[v];
            if (newDist < dist[v]) {
                dist[v] = newDist;
                pq.push({newDist, v});
            }
        }
    }
    
    if (dist[end] == LLONG_MAX) {
        cout << -1 << endl;
    } else {
        cout << dist[end] << endl;
    }
    
    return 0;
}
