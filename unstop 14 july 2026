#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<long long> energy(n + 1);
    for (int i = 1; i <= n; i++) cin >> energy[i];

    vector<long long> dp(n + 1, LLONG_MAX);
    dp[1] = 0;

    for (int j = 2; j <= n; j++) {
        for (int i = 1; i < j; i++) {
            if (dp[i] == LLONG_MAX) continue;
            long long cost = dp[i] + llabs(energy[i] - energy[j]) * (j - i);
            dp[j] = min(dp[j], cost);
        }
    }

    cout << dp[n] << endl;
    return 0;
}
