#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
#include <unordered_map>
using namespace std;

int main() {
    int n;
    cin >> n;
    vector<long long> ids(n);
    unordered_map<long long, int> freq;
    for (int i = 0; i < n; i++) {
        cin >> ids[i];
        freq[ids[i]]++;
    }

    long long bestId = 0;
    int bestFreq = -1;

    for (auto &p : freq) {
        if (p.second > bestFreq || (p.second == bestFreq && p.first < bestId)) {
            bestFreq = p.second;
            bestId = p.first;
        }
    }

    cout << bestId << " " << bestFreq << endl;
    return 0;
}
