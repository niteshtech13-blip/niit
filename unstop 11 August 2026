#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    scanf("%d", &n);
    vector<pair<int,long long>> v(n); // {deadline, crates}
    for (int i = 0; i < n; i++) {
        int d; long long c;
        scanf("%d %lld", &d, &c);
        v[i] = {d, c};
    }
    
    sort(v.begin(), v.end(), [](const pair<int,long long>&a, const pair<int,long long>&b){
        return a.first < b.first;
    });
    
    priority_queue<long long, vector<long long>, greater<long long>> minHeap;
    long long total = 0;
    
    for (int i = 0; i < n; i++) {
        int d = v[i].first;
        long long c = v[i].second;
        
        if ((int)minHeap.size() < d) {
            minHeap.push(c);
            total += c;
        } else if (!minHeap.empty() && minHeap.top() < c) {
            total -= minHeap.top();
            minHeap.pop();
            minHeap.push(c);
            total += c;
        }
    }
    
    printf("%lld\n", total);
    return 0;
}
