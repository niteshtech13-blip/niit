#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n;
    long long d;
    scanf("%d %lld", &n, &d);
    vector<long long> a(n);
    for (int i = 0; i < n; i++) scanf("%lld", &a[i]);
    
    sort(a.begin(), a.end());
    
    int count = 1;
    long long last = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] - last >= d) {
            count++;
            last = a[i];
        }
    }
    
    printf("%d\n", count);
    return 0;
}
