#include <cmath>
#include <cstdio>
#include <vector>
#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int n;
    scanf("%d", &n);
    vector<long long> a(n);
    for (int i = 0; i < n; i++) scanf("%lld", &a[i]);

    long long incl = 0, excl = 0; // incl = best ending by taking current, excl = best without current
    for (int i = 0; i < n; i++) {
        long long newIncl = excl + a[i];
        long long newExcl = max(incl, excl);
        incl = newIncl;
        excl = newExcl;
    }

    printf("%lld\n", max(incl, excl));
    return 0;
}
