#include<bits/stdc++.h>
using namespace std;

struct Tower {
    long long signal;
    int left;
    int right;
};

vector<Tower> towers;
int peakCount = 0;

// Returns maximum signal in subtree rooted at idx
// Returns -1 if idx == -1 (no node exists)
long long dfs(int idx) {
    // Node doesn't exist
    if (idx == -1) {
        return -1;
    }
    
    Tower& node = towers[idx];
    
    // Get max signal from left subtree
    long long maxLeftSignal = dfs(node.left);
    
    // Get max signal from right subtree
    long long maxRightSignal = dfs(node.right);
    
    // Get max among all descendants (excluding current node)
    long long maxInDescendants = max(maxLeftSignal, maxRightSignal);
    
    // Check if current tower is a Peak Relay
    // Peak Relay: has no descendants OR signal > all descendants
    if (maxInDescendants == -1) {
        // Leaf node - always Peak Relay
        peakCount++;
        return node.signal;
    } else if (node.signal > maxInDescendants) {
        // Signal is greater than all descendants
        peakCount++;
        return node.signal;
    } else {
        // Not a Peak Relay, but return max for parent's consideration
        return maxInDescendants;
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    
    int n;
    cin >> n;
    
    towers.resize(n);
    
    // Read all tower data
    for (int i = 0; i < n; i++) {
        cin >> towers[i].signal >> towers[i].left >> towers[i].right;
    }
    
    // Start DFS from root tower (index 0)
    dfs(0);
    
    // Output the count of Peak Relay towers
    cout << peakCount << endl;
    
    return 0;
}
