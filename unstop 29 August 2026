#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    long long L;
    cin >> n >> L;

    vector<long long> arr(n);
    for (int i = 0; i < n; i++) {
        cin >> arr[i];
    }

    deque<int> maxDq, minDq;

    int left = 0;
    long long currentSum = 0;
    long long answer = 0;

    for (int right = 0; right < n; right++) {
        currentSum += arr[right];

        while (!maxDq.empty() && arr[maxDq.back()] <= arr[right])
            maxDq.pop_back();
        maxDq.push_back(right);

        while (!minDq.empty() && arr[minDq.back()] >= arr[right])
            minDq.pop_back();
        minDq.push_back(right);

        while (arr[maxDq.front()] - arr[minDq.front()] > L) {
            currentSum -= arr[left];

            if (maxDq.front() == left)
                maxDq.pop_front();

            if (minDq.front() == left)
                minDq.pop_front();

            left++;
        }

        answer = max(answer, currentSum);
    }

    cout << answer << '\n';

    return 0;
}
                
