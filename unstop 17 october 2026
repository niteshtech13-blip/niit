#include <bits/stdc++.h>
using namespace std;

const int MAXN = 200005;
int parent[MAXN], rnk[MAXN];
int cap[MAXN];
set<pair<int,int>> act[MAXN];

int find(int x) {
    if (parent[x] != x) parent[x] = find(parent[x]);
    return parent[x];
}

void unite(int a, int b) {
    int ra = find(a), rb = find(b);
    if (ra == rb) return;
    if (rnk[ra] < rnk[rb]) swap(ra, rb);
    parent[rb] = ra;
    if (rnk[ra] == rnk[rb]) rnk[ra]++;
    if (act[rb].size() > act[ra].size()) act[ra].swap(act[rb]);
    for (auto &p : act[rb]) act[ra].insert(p);
    act[rb].clear();
}

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);
    int n;
    cin >> n;
    for (int i = 1; i <= n; i++) {
        cin >> cap[i];
        parent[i] = i;
        rnk[i] = 0;
    }
    int m;
    cin >> m;
    for (int i = 0; i < m; i++) {
        string typ;
        cin >> typ;
        if (typ == "LINK") {
            int a, b;
            cin >> a >> b;
            unite(a, b);
        } else if (typ == "ON") {
            int s;
            cin >> s;
            int r = find(s);
            act[r].insert({cap[s], s});
        } else if (typ == "OFF") {
            int s;
            cin >> s;
            int r = find(s);
            act[r].erase({cap[s], s});
        } else {
            int s;
            cin >> s;
            int r = find(s);
            if (act[r].empty()) {
                cout << -1 << " " << -1 << "\n";
            } else {
                auto it = act[r].rbegin();
                cout << it->first << " " << it->second << "\n";
            }
        }
    }
    return 0;
}
