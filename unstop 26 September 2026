#include <bits/stdc++.h>
using namespace std;

struct Edge {
    int u, v;
    long long cost;
};

struct Query {
    int a, b;
    long long budget;
    int id;
};

class DSU {
    vector<int> parent, sz;

public:
    DSU(int n) {
        parent.resize(n + 1);
        sz.assign(n + 1, 1);

        iota(parent.begin(), parent.end(), 0);
    }

    int find(int x) {
        if (parent[x] == x)
            return x;

        return parent[x] = find(parent[x]);
    }

    void unite(int a, int b) {
        a = find(a);
        b = find(b);

        if (a == b)
            return;

        if (sz[a] < sz[b])
            swap(a, b);

        parent[b] = a;
        sz[a] += sz[b];
    }

    bool connected(int a, int b) {
        return find(a) == find(b);
    }
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m, q;
    cin >> n >> m >> q;

    vector<Edge> edges(m);

    for (int i = 0; i < m; i++) {
        cin >> edges[i].u >> edges[i].v >> edges[i].cost;
    }

    vector<Query> queries(q);

    for (int i = 0; i < q; i++) {
        cin >> queries[i].a
            >> queries[i].b
            >> queries[i].budget;

        queries[i].id = i;
    }

    // Sort corridors by construction cost.
    sort(edges.begin(), edges.end(), [](const Edge& x, const Edge& y) {
        return x.cost < y.cost;
    });

    // Sort queries by their budget.
    sort(queries.begin(), queries.end(), [](const Query& x, const Query& y) {
        return x.budget < y.budget;
    });

    DSU dsu(n);

    vector<string> answer(q);

    int edgeIndex = 0;

    for (const Query& query : queries) {

        // Add every corridor affordable under this budget.
        while (edgeIndex < m &&
               edges[edgeIndex].cost <= query.budget) {

            dsu.unite(
                edges[edgeIndex].u,
                edges[edgeIndex].v
            );

            edgeIndex++;
        }

        if (dsu.connected(query.a, query.b))
            answer[query.id] = "YES";
        else
            answer[query.id] = "NO";
    }

    // Restore original query order.
    for (const string& ans : answer) {
        cout << ans << '\n';
    }

    return 0;
}
