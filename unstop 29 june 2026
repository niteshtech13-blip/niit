#include <iostream>
#include <vector>
#include <bits/stdc++.h>
using namespace std;

int getNegativeNumberWaves(vector<int>&diff,int& idx)
{
    int curWaves = 0;
    while(diff[idx] < 0)
    {
        int requiredWaves = diff[idx];
        int d = abs(curWaves-requiredWaves);
        if(curWaves < abs(requiredWaves))
            curWaves += d;
        idx++;
    }
    return curWaves;
}

int getPositiveNumberWaves(vector<int>&diff,int& idx)
{
    int curWaves = 0;
    while(diff[idx] > 0)
    {
        int requiredWaves = diff[idx];
        int d = abs(curWaves-requiredWaves);
        if(curWaves < requiredWaves)
            curWaves += d;
        idx++;
    }
    return curWaves;
}

