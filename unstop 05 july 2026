#include <iostream>
#include <vector>
#include <unordered_map>
using namespace std;

class Node {
public:
    int node_id;
    int value;
    int next_id;
    Node* next;

    Node(int node_id, int value, int next_id) : node_id(node_id), value(value), next_id(next_id), next(nullptr) {}
};

void recover_chain(int n, vector<Node>& node_details, int start_id) {
    // Step 1: Build id -> Node* map and link pointers based on next_id
    unordered_map<int, Node*> id2node;
    id2node.reserve(n * 2);
    for (int i = 0; i < n; ++i) {
        id2node[node_details[i].node_id] = &node_details[i];
    }
    for (int i = 0; i < n; ++i) {
        int nid = node_details[i].next_id;
        if (nid != -1) {
            auto it = id2node.find(nid);
            if (it != id2node.end()) {
                node_details[i].next = it->second;
            }
        }
    }

    // If start_id doesn't exist, nothing to print
    auto startIt = id2node.find(start_id);
    if (startIt == id2node.end()) {
        return;
    }
    Node* start = startIt->second;

    // Step 2: Floyd's cycle detection (only pointer manipulation, O(1) extra memory)
    Node* slow = start;
    Node* fast = start;
    Node* meetingPoint = nullptr;

    while (fast != nullptr && fast->next != nullptr) {
        slow = slow->next;
        fast = fast->next->next;
        if (slow == fast) {
            meetingPoint = slow;
            break;
        }
    }

    // Step 3: If a cycle exists, find the entrance node of the cycle
    if (meetingPoint != nullptr) {
        Node* p1 = start;
        Node* p2 = meetingPoint;
        while (p1 != p2) {
            p1 = p1->next;
            p2 = p2->next;
        }
        Node* cycleEntrance = p1;

        // Step 4: Walk around the cycle once, and break it at the node
        // whose 'next' points back to the entrance
        Node* cur = cycleEntrance;
        while (cur->next != cycleEntrance) {
            cur = cur->next;
        }
        cur->next = nullptr; // break the cycle in-place
    }

    // Step 5: Traverse from start and print values, space-separated
    Node* cur = start;
    bool first = true;
    while (cur != nullptr) {
        if (!first) cout << " ";
        cout << cur->value;
        first = false;
        cur = cur->next;
    }
    cout << endl;
}

int main() {
    int n;
    cin >> n;
    vector<Node> node_details;
    node_details.reserve(n);
    for (int i = 0; i < n; ++i) {
        int node_id, value, next_id;
        cin >> node_id >> value >> next_id;
        node_details.emplace_back(node_id, value, next_id);
    }
    int start_id;
    cin >> start_id;
    recover_chain(n, node_details, start_id);
    return 0;
}
