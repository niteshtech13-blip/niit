#include <iostream>
#include <vector>
#include <string>

std::vector<std::string> user_logic(const std::vector<std::string>& initial_cards) {
    std::vector<std::string> current_deck = initial_cards;
    bool reaction_occurred = true;

    while (reaction_occurred) {
        reaction_occurred = false;
        int n = current_deck.size();
        if (n < 3) break;

        std::vector<bool> to_remove(n, false);
        
        for (int i = 0; i < n; ) {
            int j = i;
            while (j < n && current_deck[j][0] == current_deck[i][0]) {
                j++;
            }
            if (j - i >= 3) {
                reaction_occurred = true;
                for (int k = i; k < j; ++k) to_remove[k] = true;
            }
            i = j;
        }

        for (int i = 0; i < n; ) {
            int j = i;
            while (j < n && current_deck[j][1] == current_deck[i][1]) {
                j++;
            }
            if (j - i >= 3) {
                reaction_occurred = true;
                for (int k = i; k < j; ++k) to_remove[k] = true;
            }
            i = j;
        }

        if (reaction_occurred) {
            std::vector<std::string> next_deck;
            for (int i = 0; i < n; ++i) {
                if (!to_remove[i]) {
                    next_deck.push_back(current_deck[i]);
                }
            }
            current_deck = next_deck;
        }
    }
    return current_deck;
}
