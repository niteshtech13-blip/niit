#include <iostream>
#include <vector>
#include <string>
#include <algorithm>

using namespace std;

// --- Wavelet Tree for Range K-th Smallest Query ---
struct WaveletTree {
    int low, high;
    WaveletTree *left = nullptr, *right = nullptr;
    vector<int> b; // b[i] stores the count of elements in prefix [0...i-1] that go to the left child

    // Construct the wavelet tree for elements in the range [from, to) with values in [low, high]
    WaveletTree(int* from, int* to, int low, int high) : low(low), high(high) {
        if (low == high || from >= to) return;
        
        int mid = low + (high - low) / 2;
        auto f = [mid](int x) { return x <= mid; };
        
        b.reserve(to - from + 1);
        b.push_back(0);
        for (auto it = from; it != to; ++it) {
            b.push_back(b.back() + f(*it));
        }
        
        auto pivot = stable_partition(from, to, f);
        left = new WaveletTree(from, pivot, low, mid);
        right = new WaveletTree(pivot, to, mid + 1, high);
    }

    // Returns the k-th smallest element in the range [l, r]
    int kth(int l, int r, int k) {
        if (low == high) return low;
        
        int count_left = b[r] - b[l - 1];
        if (k <= count_left) {
            return left->kth(b[l - 1] + 1, b[r], k);
        } else {
            return right->kth(l - b[l - 1], r - b[r], k - count_left);
        }
    }

    ~WaveletTree() {
        delete left;
        delete right;
    }
};

// --- Binary Indexed Tree (Fenwick Tree) for Dynamic Range Sum ---
struct FenwickTree {
    int n;
    vector<int> tree;

    FenwickTree(int n) : n(n), tree(n + 1, 0) {}

    void add(int i, int delta) {
        for (; i <= n; i += i & -i) {
            tree[i] += delta;
        }
    }

    int query(int i) {
        int sum = 0;
        for (; i > 0; i -= i & -i) {
            sum += tree[i];
        }
        return sum;
    }

    int query(int l, int r) {
        return query(r) - query(l - 1);
    }
};

int main() {
    // Optimize standard I/O operations for performance
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, q;
    if (!(cin >> n >> q)) return 0;

    vector<int> a(n);
    int min_val = 1e9, max_val = 1;
    for (int i = 0; i < n; ++i) {
        cin >> a[i];
        if (a[i] < min_val) min_val = a[i];
        if (a[i] > max_val) max_val = a[i];
    }

    // Build the Wavelet Tree using the initial array
    WaveletTree* wavelet = new WaveletTree(a.data(), a.data() + n, min_val, max_val);

    // Track the flags using a BIT and a boolean status tracker
    FenwickTree bit(n);
    vector<bool> flagged(n + 1, false);

    // Process all incoming events streaming throughout the day
    for (int i = 0; i < q; ++i) {
        string type;
        cin >> type;
        if (type == "RANK") {
            int l, r, k;
            cin >> l >> r >> k;
            cout << wavelet->kth(l, r, k) << "\n";
        } else if (type == "FLAG") {
            int idx;
            cin >> idx;
            if (flagged[idx]) {
                bit.add(idx, -1);
                flagged[idx] = false;
            } else {
                bit.add(idx, 1);
                flagged[idx] = true;
            }
        } else if (type == "AUDIT") {
            int l, r;
            cin >> l >> r;
            cout << bit.query(l, r) << "\n";
        }
    }

    delete wavelet;
    return 0;
}
