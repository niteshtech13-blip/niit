#include <stdio.h>
#include <stdlib.h>

#define MAXN 200005

typedef long long ll;

typedef struct {
    ll profit;
    ll deadline;
} Job;

int parent[MAXN];

/*
 * find(x) = largest currently available slot <= x
 *
 * If slot x is occupied, parent[x] points to the next
 * candidate slot on the left.
 */
int find_slot(int x) {
    if (parent[x] == x)
        return x;

    return parent[x] = find_slot(parent[x]);
}

int compare_jobs(const void *a, const void *b) {
    const Job *x = (const Job *)a;
    const Job *y = (const Job *)b;

    if (x->profit < y->profit)
        return 1;

    if (x->profit > y->profit)
        return -1;

    /* Tie-break is irrelevant to the answer */
    if (x->deadline < y->deadline)
        return -1;

    if (x->deadline > y->deadline)
        return 1;

    return 0;
}

int main(void) {
    int n;
    scanf("%d", &n);

    Job *jobs = malloc(n * sizeof(Job));

    if (jobs == NULL)
        return 1;

    for (int i = 0; i < n; i++) {
        scanf("%lld %lld",
              &jobs[i].profit,
              &jobs[i].deadline);
    }

    /*
     * There are only n jobs, therefore an optimal solution
     * can never need more than n occupied slots.
     */
    for (int i = 0; i <= n; i++)
        parent[i] = i;

    qsort(jobs, n, sizeof(Job), compare_jobs);

    ll totalProfit = 0;
    int accepted = 0;

    for (int i = 0; i < n; i++) {

        int deadline;

        if (jobs[i].deadline > n)
            deadline = n;
        else
            deadline = (int)jobs[i].deadline;

        /*
         * Find the latest free slot <= deadline.
         */
        int slot = find_slot(deadline);

        if (slot > 0) {
            /*
             * Occupy this slot.
             *
             * After using slot x, the next available slot
             * for future jobs is x-1.
             */
            parent[slot] = find_slot(slot - 1);

            totalProfit += jobs[i].profit;
            accepted++;
        }
    }

    printf("%lld %d\n", totalProfit, accepted);

    free(jobs);

    return 0;
}
    
