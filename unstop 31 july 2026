#include <bits/stdc++.h>
using namespace std;

int main(){
    int n;
    scanf("%d",&n);
    vector<vector<pair<int,long long>>> adj(n+1);
    for(int i=0;i<n-1;i++){
        int u,v; long long w;
        scanf("%d %d %lld",&u,&v,&w);
        adj[u].push_back({v,w});
        adj[v].push_back({u,w});
    }
    vector<long long> pathScore(n+1,0);
    vector<int> parent(n+1,0);
    vector<int> order; order.reserve(n);
    vector<char> visited(n+1,0);

    vector<int> stk; stk.reserve(n);
    stk.push_back(1);
    visited[1]=1;
    while(!stk.empty()){
        int u = stk.back(); stk.pop_back();
        order.push_back(u);
        for(auto &pr: adj[u]){
            int v=pr.first; long long w=pr.second;
            if(!visited[v]){
                visited[v]=1;
                parent[v]=u;
                pathScore[v]=pathScore[u]+w;
                stk.push_back(v);
            }
        }
    }

    vector<long long> subMax(n+1), subMin(n+1);
    for(int i=1;i<=n;i++){ subMax[i]=pathScore[i]; subMin[i]=pathScore[i]; }

    // reverse order -> children process ho jaate hain parent se pehle
    for(int i=(int)order.size()-1;i>=0;i--){
        int u=order[i];
        if(u!=1){
            int p=parent[u];
            if(subMax[u]>subMax[p]) subMax[p]=subMax[u];
            if(subMin[u]<subMin[p]) subMin[p]=subMin[u];
        }
    }

    int q;
    scanf("%d",&q);
    string out;
    out.reserve((size_t)q*8);
    for(int i=0;i<q;i++){
        int v; scanf("%d",&v);
        long long ans = subMax[v]-subMin[v];
        out += to_string(ans);
        out += '\n';
    }
    fputs(out.c_str(), stdout);
    return 0;
}
