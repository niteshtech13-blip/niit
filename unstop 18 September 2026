#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    long long L;

    cin >> n >> L;

    vector<long long> speed(n);

    for (int i = 0; i < n; i++) {
        cin >> speed[i];
    }

    // Stores indices.
    deque<int> maxDeque;
    deque<int> minDeque;

    int left = 0;
    int answer = 0;

    for (int right = 0; right < n; right++) {

        // Maintain maxDeque in decreasing order.
        while (!maxDeque.empty() &&
               speed[maxDeque.back()] <= speed[right]) {
            maxDeque.pop_back();
        }
        maxDeque.push_back(right);

        // Maintain minDeque in increasing order.
        while (!minDeque.empty() &&
               speed[minDeque.back()] >= speed[right]) {
            minDeque.pop_back();
        }
        minDeque.push_back(right);

        // Shrink the window until it becomes valid.
        while (speed[maxDeque.front()] - speed[minDeque.front()] > L) {

            if (maxDeque.front() == left) {
                maxDeque.pop_front();
            }

            if (minDeque.front() == left) {
                minDeque.pop_front();
            }

            left++;
        }

        // Current window [left, right] is valid.
        answer = max(answer, right - left + 1);
    }

    cout << answer << '\n';

    return 0;
}
