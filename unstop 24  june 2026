import java.io.*;
import java.util.*;

public class Main {

    public static void main(String[] args) throws Exception {

        BufferedReader br = new BufferedReader(new InputStreamReader(System.in));

        int n = Integer.parseInt(br.readLine().trim());

        int[] cnt = new int[105];

        StringTokenizer st = new StringTokenizer(br.readLine());

        for (int i = 0; i < n; i++) {
            cnt[Integer.parseInt(st.nextToken())]++;
        }

        int NEG = -1000000000;

        int[][] dp = new int[9][5];

        for (int i = 0; i < 9; i++) {
            Arrays.fill(dp[i], NEG);
        }

        dp[0][0] = 0;

        for (int x = 1; x <= 100; x++) {

            int[][] ndp = new int[9][5];

            for (int i = 0; i < 9; i++) {
                Arrays.fill(ndp[i], NEG);
            }

            for (int a = 0; a <= 8; a++) {
                for (int b = 0; b <= 4; b++) {

                    if (dp[a][b] < 0) continue;

                    for (int take = 0; take <= 4; take++) {

                        if (a + take > cnt[x]) continue;
                        if (b + take > cnt[x + 1]) continue;
                        if (take > cnt[x + 2]) continue;

                        int cur =
                                dp[a][b]
                                + take
                                + (cnt[x] - a - take) / 3;

                        ndp[b + take][take] =
                                Math.max(
                                        ndp[b + take][take],
                                        cur
                                );
                    }
                }
            }

            dp = ndp;
        }

        System.out.println(dp[0][0]);
    }
}
