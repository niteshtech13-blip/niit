#include <iostream>
#include <deque>
#include <algorithm>
#include <string>

using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n, m;
    if (!(cin >> n >> m)) return 0;

    deque<int> q;
    int next_passenger_id = 1;

    for (int i = 0; i < m; ++i) {
        char type;
        cin >> type;

        if (type == 'A') {
            // Next passenger arrives and joins the back
            q.push_back(next_passenger_id++);
        } 
        else if (type == 'P') {
            int x;
            cin >> x;
            // Search for passenger x in the queue
            auto it = find(q.begin(), q.end(), x);
            if (it != q.end()) {
                // Remove passenger x from their current position and push to the front
                q.erase(it);
                q.push_front(x);
            }
        } 
        else if (type == 'B') {
            // Passenger at the front boards
            if (q.empty()) {
                cout << 0 << "\n";
            } else {
                cout << q.front() << "\n";
                q.pop_front();
            }
        }
    }

    return 0;
}
                
