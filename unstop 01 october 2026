#include <bits/stdc++.h>
using namespace std;

struct DSU {
    vector<int> p, sz;
    vector<long long> mx;
    DSU(int n = 0) { init(n); }
    void init(int n) {
        p.resize(n);
        sz.assign(n, 1);
        mx.assign(n, 0);
        iota(p.begin(), p.end(), 0);
    }
    int find(int x) {
        if (p[x] == x) return x;
        return p[x] = find(p[x]);
    }
    void unite(int a, int b) {
        a = find(a); b = find(b);
        if (a == b) return;
        if (sz[a] < sz[b]) swap(a, b);
        p[b] = a;
        sz[a] += sz[b];
        mx[a] = max(mx[a], mx[b]);
    }
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    if (!(cin >> n)) return 0;
    vector<long long> rating(n);
    unordered_map<string,int> id;
    id.reserve(n * 2);
    for (int i = 0; i < n; ++i) {
        string code; long long r;
        cin >> code >> r;
        id[code] = i;
        rating[i] = r;
    }
    DSU dsu(n);
    for (int i = 0; i < n; ++i) dsu.mx[i] = rating[i];

    int q;
    cin >> q;
    for (int i = 0; i < q; ++i) {
        string op;
        cin >> op;
        if (op == "LINK") {
            string xs, ys;
            cin >> xs >> ys;
            auto itx = id.find(xs);
            auto ity = id.find(ys);
            if (itx == id.end() || ity == id.end()) continue; // safety
            dsu.unite(itx->second, ity->second);
        } else if (op == "BOOST") {
            string xs; long long v;
            cin >> xs >> v;
            auto itx = id.find(xs);
            if (itx == id.end()) continue;
            int idx = itx->second;
            rating[idx] += v;
            int r = dsu.find(idx);
            if (rating[idx] > dsu.mx[r]) dsu.mx[r] = rating[idx];
        } else if (op == "QUERY") {
            string xs;
            cin >> xs;
            auto itx = id.find(xs);
            if (itx == id.end()) {
                cout << 0 << '\n';
            } else {
                int idx = itx->second;
                int r = dsu.find(idx);
                cout << dsu.mx[r] << '\n';
            }
        }
    }
    return 0;
}
                
