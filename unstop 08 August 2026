#include <iostream>
#include <vector>
#include <algorithm>
#include <string>
using namespace std;

struct Query {
    char type;
    int a, b;
};

struct Fenwick {
    int n;
    vector<int> bit;
    Fenwick(int n) : n(n), bit(n + 1, 0) {}

    void add(int idx, int val) {
        for (; idx <= n; idx += idx & -idx) bit[idx] += val;
    }

    int sum(int idx) {
        int res = 0;
        for (; idx > 0; idx -= idx & -idx) res += bit[idx];
        return res;
    }

    int kth(int k) {
        int idx = 0;
        int pw = 1;
        while ((pw << 1) <= n) pw <<= 1;
        for (; pw; pw >>= 1) {
            int nxt = idx + pw;
            if (nxt <= n && bit[nxt] < k) {
                k -= bit[nxt];
                idx = nxt;
            }
        }
        return idx + 1;
    }
};

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n;
    cin >> n;

    vector<int> a(n + 1);
    vector<int> vals;
    for (int i = 1; i <= n; i++) {
        cin >> a[i];
        vals.push_back(a[i]);
    }

    int q;
    cin >> q;

    vector<Query> ops(q);

    for (int i = 0; i < q; i++) {
        cin >> ops[i].type;
        if (ops[i].type == 'U') {
            cin >> ops[i].a >> ops[i].b;
            vals.push_back(ops[i].b);
        } else {
            cin >> ops[i].a;
        }
    }

    sort(vals.begin(), vals.end());
    vals.erase(unique(vals.begin(), vals.end()), vals.end());

    Fenwick ft(vals.size());

    for (int i = 1; i <= n; i++) {
        int idx = lower_bound(vals.begin(), vals.end(), a[i]) - vals.begin() + 1;
        ft.add(idx, 1);
    }

    for (auto &op : ops) {
        if (op.type == 'U') {
            int i = op.a;
            int v = op.b;
            int oldIdx = lower_bound(vals.begin(), vals.end(), a[i]) - vals.begin() + 1;
            ft.add(oldIdx, -1);
            a[i] = v;
            int newIdx = lower_bound(vals.begin(), vals.end(), a[i]) - vals.begin() + 1;
            ft.add(newIdx, 1);
        } else if (op.type == 'C') {
            int pos = upper_bound(vals.begin(), vals.end(), op.a) - vals.begin();
            cout << ft.sum(pos) << '\n';
        } else {
            int idx = ft.kth(op.a);
            cout << vals[idx - 1] << '\n';
        }
    }

    return 0;
}
