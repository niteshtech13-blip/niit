#include <bits/stdc++.h>
using namespace std;

static const int B = 20;
static const int MAXN = 200000 * B + 5;
int ch[MAXN][2], cntNode[MAXN], tot = 1;

void upd(int x, int d) {
    int cur = 0;
        for (int i = B - 1; i >= 0; i--) {
                int b = (x >> i) & 1;
                        if (!ch[cur][b]) ch[cur][b] = tot++;
                                cur = ch[cur][b];
                                        cntNode[cur] += d;
                                            }
                                            }

                                            int query(int x) {
                                                int cur = 0, res = 0;
                                                    for (int i = B - 1; i >= 0; i--) {
                                                            int b = (x >> i) & 1;
                                                                    int want = b ^ 1;
                                                                            int nxt = ch[cur][want];
                                                                                    if (nxt && cntNode[nxt] > 0) {
                                                                                                res |= (1 << i);
                                                                                                            cur = nxt;
                                                                                                                    } else {
                                                                                                                                cur = ch[cur][b];
                                                                                                                                        }
                                                                                                                                            }
                                                                                                                                                return res;
                                                                                                                                                }

                                                                                                                                                int main() {
                                                                                                                                                    int n, K;
                                                                                                                                                        scanf("%d %d", &n, &K);
                                                                                                                                                            unordered_map<string, int> codeOf;
                                                                                                                                                                codeOf.reserve(n * 2 + 1);
                                                                                                                                                                    priority_queue<int, vector<int>, greater<int>> pq;
                                                                                                                                                                        int active = 0;
                                                                                                                                                                            char op[16], name[32];
                                                                                                                                                                                string out;

                                                                                                                                                                                    for (int i = 0; i < n; i++) {
                                                                                                                                                                                            scanf("%s %s", op, name);
                                                                                                                                                                                                    string nm(name);
                                                                                                                                                                                                            if (op[0] == 'R' && op[2] == 'G') {          // REGISTER
                                                                                                                                                                                                                        int code;
                                                                                                                                                                                                                                    scanf("%d", &code);
                                                                                                                                                                                                                                                codeOf[nm] = code;
                                                                                                                                                                                                                                                            upd(code, 1);
                                                                                                                                                                                                                                                                        active++;
                                                                                                                                                                                                                                                                                } else if (op[0] == 'R') {                   // RETIRE
                                                                                                                                                                                                                                                                                            int code = codeOf[nm];
                                                                                                                                                                                                                                                                                                        upd(code, -1);
                                                                                                                                                                                                                                                                                                                    active--;
                                                                                                                                                                                                                                                                                                                            } else {                                     // PING
                                                                                                                                                                                                                                                                                                                                        int ans;
                                                                                                                                                                                                                                                                                                                                                    if (active <= 1) {
                                                                                                                                                                                                                                                                                                                                                                    ans = -1;
                                                                                                                                                                                                                                                                                                                                                                                } else {
                                                                                                                                                                                                                                                                                                                                                                                                int code = codeOf[nm];
                                                                                                                                                                                                                                                                                                                                                                                                                upd(code, -1);
                                                                                                                                                                                                                                                                                                                                                                                                                                ans = query(code);
                                                                                                                                                                                                                                                                                                                                                                                                                                                upd(code, 1);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                if (K > 0) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if ((int)pq.size() < K) pq.push(ans);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        else if (ans > pq.top()) { pq.pop(); pq.push(ans); }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                out += to_string(ans);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            out += '\n';
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            vector<int> v;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                while (!pq.empty()) { v.push_back(pq.top()); pq.pop(); }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    reverse(v.begin(), v.end());

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        fputs(out.c_str(), stdout);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            if (v.empty()) puts("NONE");
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                else {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        for (size_t i = 0; i < v.size(); i++) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    if (i) putchar(' ');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                printf("%d", v[i]);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                putchar('\n');
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        return 0;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        }
           
