#include <iostream>
#include <vector>
#include <set>

// Include policy-based data structure for order statistics
#include <ext/pb_ds/assoc_container.hpp>
#include <ext/pb_ds/tree_policy.hpp>

using namespace std;
using namespace __gnu_pbds;

// Custom tree structure to act as an order statistic tree
// Stores pairs of (value, pedestal_number) to maintain uniqueness and sorting
typedef tree<
    pair<int, int>,
        null_type,
            less<pair<int, int>>,
                rb_tree_tag,
                    tree_order_statistics_node_update
                    > ordered_set;

                    int main() {
                        // Optimize standard I/O operations for speed
                            ios_base::sync_with_stdio(false);
                                cin.tie(NULL);

                                    int n;
                                        if (!(cin >> n)) return 0;

                                            vector<int> vals(n + 1);
                                                set<int> active_pedestals;
                                                    ordered_set remaining_values;

                                                        for (int i = 1; i <= n; ++i) {
                                                                cin >> vals[i];
                                                                        active_pedestals.insert(i);
                                                                                // Store as (value, pedestal)
                                                                                        remaining_values.insert({vals[i], i});
                                                                                            }

                                                                                                int m;
                                                                                                    cin >> m;

                                                                                                        while (m--) {
                                                                                                                char type;
                                                                                                                        cin >> type;

                                                                                                                                if (type == 'R') {
                                                                                                                                            int p;
                                                                                                                                                        cin >> p;
                                                                                                                                                                    
                                                                                                                                                                                // Remove from active pedestals and the order statistic tree
                                                                                                                                                                                            active_pedestals.erase(p);
                                                                                                                                                                                                        remaining_values.erase({vals[p], p});
                                                                                                                                                                                                                } 
                                                                                                                                                                                                                        else if (type == 'N') {
                                                                                                                                                                                                                                    int p;
                                                                                                                                                                                                                                                cin >> p;

                                                                                                                                                                                                                                                            // Find nearest right neighbor
                                                                                                                                                                                                                                                                        auto it = active_pedestals.upper_bound(p);
                                                                                                                                                                                                                                                                                    int right_neighbor = (it == active_pedestals.end()) ? -1 : *it;

                                                                                                                                                                                                                                                                                                // Find nearest left neighbor
                                                                                                                                                                                                                                                                                                            it = active_pedestals.lower_bound(p);
                                                                                                                                                                                                                                                                                                                        int left_neighbor = -1;
                                                                                                                                                                                                                                                                                                                                    if (it != active_pedestals.begin()) {
                                                                                                                                                                                                                                                                                                                                                    left_neighbor = *prev(it);
                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                            cout << left_neighbor << " " << right_neighbor << "\n";
                                                                                                                                                                                                                                                                                                                                                                                    } 
                                                                                                                                                                                                                                                                                                                                                                                            else if (type == 'K') {
                                                                                                                                                                                                                                                                                                                                                                                                        int k;
                                                                                                                                                                                                                                                                                                                                                                                                                    cin >> k;

                                                                                                                                                                                                                                                                                                                                                                                                                                int total_remaining = remaining_values.size();
                                                                                                                                                                                                                                                                                                                                                                                                                                            if (k > total_remaining || k <= 0) {
                                                                                                                                                                                                                                                                                                                                                                                                                                                            cout << "-1 -1\n";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                        } else {
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        // The k-th highest element corresponds to the (total - k)-th element in 0-indexed ascending order
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        int target_idx = total_remaining - k;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        auto it = remaining_values.find_by_order(target_idx);
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                        cout << it->first << " " << it->second << "\n";
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            }
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                }

                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    return 0;
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                    }
           
